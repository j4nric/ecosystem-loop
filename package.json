{
  "name": "being-god",
  "version": "1.0.0",
  "description": "Being God (ain't easy) \u2013 \u00d6kosystem-Spiel f\u00fcr iOS/Android",
  "scripts": {
    "play": "tsx packages/sim/src/cli/play.ts",
    "sim": "tsx packages/sim/src/cli/simulate.ts",
    "validate": "tsx packages/sim/src/cli/validate.ts && tsx packages/herde/src/node/cli/validate.ts",
    "herde": "tsx packages/herde/src/node/cli/play.ts",
    "herde:smoke": "tsx packages/herde/src/node/cli/smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && npm run -w apps/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run validate",
    "build": "npm run -w apps/web build",
    "dev": "npm run -w apps/web dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j4nric/ecosystem-loop.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/j4nric/ecosystem-loop/issues"
  },
  "homepage": "https://github.com/j4nric/ecosystem-loop#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
